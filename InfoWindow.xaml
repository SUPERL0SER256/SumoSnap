<Window x:Class="SumoSnap.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SumoSnap Guide" Height="520" Width="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="Consolas, Segoe UI"
        Background="#161619">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Industrial ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#38383E"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Foreground}" CornerRadius="2" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hardware Window Control Buttons -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1C20"/>
            <Setter Property="Foreground" Value="#888890"/>
            <Setter Property="BorderBrush" Value="#0A0A0C"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#2A2A30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#121215"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tactile Keycap Action Button -->
        <Style x:Key="KeycapActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeycapBorder" Background="#222227" BorderBrush="#0A0A0C" BorderThickness="1,1,1,3" CornerRadius="5">
                            <Border BorderBrush="#383840" BorderThickness="0,1,0,0" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,8"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeycapBorder" Property="Background" Value="#2C2C32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeycapBorder" Property="BorderThickness" Value="1,2,1,1"/>
                                <Setter TargetName="KeycapBorder" Property="Background" Value="#16161A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Matte Hardware Chassis Frame -->
    <Border BorderThickness="0" Background="#161619">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#141417" BorderBrush="#09090B" BorderThickness="0,0,0,2" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8,0,8">
                        <Image Source="pack://application:,,,/header_logo.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="SUMOSNAP // MANUAL_v1.4" Foreground="#9999A2" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="8,6,8,6">
                        <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" FontSize="11" Width="28" Height="26" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recessed Dot-Matrix LCD Screen Housing -->
            <Border Grid.Row="1" Margin="14,10,14,14" Background="#000000" BorderBrush="#28282E" BorderThickness="2" CornerRadius="6">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,24,28,28">
                            <TextBlock Text="[ SYSTEM // QUICK_START_GUIDE ]" FontSize="12" Foreground="#777780" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="SUMOSNAP // VO-01" FontSize="24" Foreground="#E8E8EC" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Your desktop screen instrument. Instantly debug code, translate text, extract data, or run daily logic and focus modules." FontSize="12" Foreground="#9999A2" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Width="480" Margin="0,0,0,26"/>

                            <Grid Margin="0,0,0,28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#121216" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="01 // CAPTURE" FontSize="12" Foreground="#E8E8EC" Margin="0,0,0,8"/>
                                        <TextBlock Text="Press Ctrl+Shift+Q to draw a region over any code, image, or text." FontSize="11" Foreground="#888890" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#121216" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="02 // BUDDY" FontSize="12" Foreground="#E8E8EC" Margin="0,0,0,8"/>
                                        <TextBlock Text="Hover over the floating corner buddy to summon or drag it anywhere." FontSize="11" Foreground="#888890" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#121216" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="03 // MODULES" FontSize="12" Foreground="#E8E8EC" Margin="0,0,0,8"/>
                                        <TextBlock Text="Switch between AI Chat, Daily Logic, 6x6 Sudoku, Chrono, and Calendar." FontSize="11" Foreground="#888890" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- FAQ Section -->
                            <Border Background="#121216" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="4" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="[ FREQUENTLY_ASKED_QUESTIONS ]" FontSize="12" Foreground="#888890" Margin="0,0,0,14"/>

                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="> Where do I get an API key?" FontSize="12" Foreground="#E8E8EC" Margin="0,0,0,4"/>
                                        <TextBlock Text="Get a free API key from Google AI Studio (Gemini), or use OpenAI/Anthropic. Paste it into the Settings module (⚙)." FontSize="11" Foreground="#888890" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="> Why isn't the floating buddy appearing?" FontSize="12" Foreground="#E8E8EC" Margin="0,0,0,4"/>
                                        <TextBlock Text="Ensure 'Show Floating Buddy' is enabled in Settings and that a valid API key is saved." FontSize="11" Foreground="#888890" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="> Can I capture across multiple monitors?" FontSize="12" Foreground="#E8E8EC" Margin="0,0,0,4"/>
                                        <TextBlock Text="Yes. Pressing Ctrl+Shift+Q spans the region selector across all connected displays." FontSize="11" Foreground="#888890" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="GetStartedBtn" Content="INITIALIZE SYSTEM" Style="{StaticResource KeycapActionButtonStyle}" Margin="0,20,0,0" Width="200" HorizontalAlignment="Center" Visibility="Collapsed" Click="Close_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
