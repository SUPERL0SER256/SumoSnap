<Window x:Class="SumoSnap.RegionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Capture" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#80000000" 
        Topmost="True" 
        ShowInTaskbar="False" 
        Cursor="Cross"
        WindowState="Maximized"
        PreviewMouseDown="Window_MouseDown" 
        PreviewMouseMove="Window_MouseMove" 
        PreviewMouseUp="Window_MouseUp"
        PreviewKeyDown="Window_KeyDown">
    <Canvas x:Name="CaptureCanvas">
        <Rectangle x:Name="SelectionRectangle" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Fill="#20FFFFFF" Visibility="Collapsed" />
    </Canvas>
</Window>
