<Window x:Class="SumoSnap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SumoSnap Settings" Height="550" Width="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        >
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Background>
        <RadialGradientBrush Center="0.5,0.0" RadiusX="1.2" RadiusY="1.2">
            <GradientStop Color="#1A1A1D" Offset="0"/>
            <GradientStop Color="#09090A" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222222"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
        
        <!-- ScrollBar Styles -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Foreground}" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Idle Dull Ring -->
                            <Border CornerRadius="18" Padding="1.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#444" Offset="0.0"/>
                                        <GradientStop Color="#111" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Hover Iridescent Ring (Fades in) -->
                            <Border x:Name="OuterRingHover" CornerRadius="18" Padding="1.5" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#111" Offset="0.0"/>
                                        <GradientStop Color="#FFF" Offset="0.3"/>
                                        <GradientStop Color="#00E5FF" Offset="0.33"/>
                                        <GradientStop Color="#FFAA00" Offset="0.38"/>
                                        <GradientStop Color="#FFF" Offset="0.42"/>
                                        <GradientStop Color="#111" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Inner Button -->
                            <Border x:Name="InnerButton" Background="#111" CornerRadius="16.5" Margin="1.5">
                                <Grid>
                                    <Border x:Name="InnerHoverOverlay" Background="#1A1A1D" Opacity="0" CornerRadius="16.5"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,10"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OuterRingHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="InnerHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OuterRingHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="InnerHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerButton" Property="Background" Value="#050505"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#1C1C1F"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/> <!-- Content -->
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#0A0A0C" BorderBrush="#1F1F22" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,10,0,10">
                        <Image Source="pack://siteoforigin:,,,/icon.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="SumoSnap Settings" Foreground="#666" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,10,10,10">
                        <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" FontSize="10" Width="30" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" FontSize="12" Width="30" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AI Chat Providers" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="1" Text="Select your preferred AI and enter its API key. Your keys are saved locally on this computer." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,20"/>

            <!-- Active Provider Selection -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Active AI:" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RadioGemini" Content="Gemini Flash (Fast)" IsChecked="True" VerticalAlignment="Center"/>
                <RadioButton x:Name="RadioGeminiPro" Content="Gemini Pro (Advanced)" VerticalAlignment="Center"/>
                <RadioButton x:Name="RadioOpenAI" Content="OpenAI (GPT-4o)" VerticalAlignment="Center"/>
                <RadioButton x:Name="RadioAnthropic" Content="Anthropic (Claude 3.5)" VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Gemini -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Google Gemini Key" FontWeight="Bold" Width="140"/>
                <TextBlock><Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#8AB4F8">Get free key here</Hyperlink></TextBlock>
            </StackPanel>
            <PasswordBox Grid.Row="4" x:Name="TxtGemini" Margin="0,0,0,15" Background="#2A2A2A" Foreground="White" BorderBrush="#444" Padding="5"/>

            <!-- OpenAI -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="OpenAI Key" FontWeight="Bold" Width="140"/>
                <TextBlock><Hyperlink NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#8AB4F8">Get key here</Hyperlink></TextBlock>
            </StackPanel>
            <PasswordBox Grid.Row="6" x:Name="TxtOpenAI" Margin="0,0,0,15" Background="#2A2A2A" Foreground="White" BorderBrush="#444" Padding="5"/>

            <!-- Anthropic -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Anthropic Key" FontWeight="Bold" Width="140"/>
                <TextBlock><Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#8AB4F8">Get key here</Hyperlink></TextBlock>
            </StackPanel>
            <PasswordBox Grid.Row="8" x:Name="TxtAnthropic" Margin="0,0,0,15" Background="#2A2A2A" Foreground="White" BorderBrush="#444" Padding="5"/>

            <!-- Token Budget -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Set Token Limit" FontWeight="Bold" Width="140"/>
                <TextBlock Text="Total tokens allowed before quota turns red" Foreground="Gray"/>
            </StackPanel>
            <TextBox Grid.Row="10" x:Name="TxtTokenBudget" Margin="0,0,0,15"/>
            
            <Button Grid.Row="11" Content="Reset Usage to 0" HorizontalAlignment="Left" Background="#333333" Foreground="#EEEEEE" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand" Click="ResetTokensButton_Click" Margin="0,0,0,15">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Grid.Row="12" Margin="0,0,0,15" Orientation="Horizontal">
                <CheckBox x:Name="ChkShowBuddy" Content="Show Floating Buddy" Foreground="White" ToolTip="Display the floating SumoSnap buddy in the bottom right corner" IsChecked="True" Margin="0,0,30,0"/>
                <CheckBox x:Name="ChkRunOnStartup" Content="Run on Startup" Foreground="White" ToolTip="Launch SumoSnap silently in the system tray when Windows starts" IsChecked="True"/>
            </StackPanel>

            <Button Grid.Row="13" Content="Save Settings" HorizontalAlignment="Right" Click="SaveButton_Click" Margin="0,15,0,0" Style="{StaticResource SaveButtonStyle}"/>
        </Grid>
        </Grid>
    </ScrollViewer>
</Window>
