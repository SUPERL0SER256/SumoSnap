<Window x:Class="SumoSnap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SumoSnap Settings" Height="560" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        FontFamily="Consolas, Segoe UI"
        Background="#161619">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Industrial ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#101012"/>
            <Setter Property="Foreground" Value="#38383E"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Foreground}" CornerRadius="2" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tactile Primary Action Keycap -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="6" Background="#0A0A0C" BorderBrush="#2D2D32" BorderThickness="1,1,1,3" Padding="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="OuterRingHover" CornerRadius="6" Padding="1.5" Opacity="0" BorderBrush="#D0D0D8" BorderThickness="1.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#44444A" Offset="0.0"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#44444A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="InnerButton" Background="#222227" CornerRadius="4.5" Margin="1.5,1.5,1.5,3">
                                <Grid>
                                    <Border x:Name="InnerHoverOverlay" Background="#2C2C32" Opacity="0" CornerRadius="4.5"/>
                                    <Border BorderBrush="#383840" BorderThickness="0,1,0,0" CornerRadius="4.5"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,8"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OuterRingHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="InnerHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OuterRingHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="InnerHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerButton" Property="Margin" Value="1.5,3,1.5,1.5"/>
                                <Setter TargetName="InnerButton" Property="Background" Value="#16161A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hardware Window Control Buttons -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1C20"/>
            <Setter Property="Foreground" Value="#888890"/>
            <Setter Property="BorderBrush" Value="#0A0A0C"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#2A2A30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#121215"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Matte Hardware Chassis Frame -->
    <Border BorderBrush="#2A2A30" BorderThickness="2" Background="#161619">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Deck -->
                <RowDefinition Height="*"/>    <!-- Recessed LCD Display Area -->
            </Grid.RowDefinitions>

            <!-- Top Hardware Control Deck -->
            <Border Grid.Row="0" Background="#141417" BorderBrush="#09090B" BorderThickness="0,0,0,2" Padding="4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8,0,8">
                        <Image Source="pack://application:,,,/header_logo.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="SUMOSNAP // SYS_CONFIG" Foreground="#9999A2" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="8,6,8,6">
                        <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" FontSize="10" Width="28" Height="26" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowControlButtonStyle}" FontSize="11" Width="28" Height="26" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recessed LCD Screen Housing -->
            <Border Grid.Row="1" Margin="14,10,14,14" Background="#000000" BorderBrush="#28282E" BorderThickness="2" CornerRadius="6">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20,16,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="[ AI_PROVIDER_CONFIGURATION ]" Foreground="#888890" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Select your active AI module and enter its API key. Keys are stored locally on this machine." TextWrapping="Wrap" Foreground="#777780" FontSize="12" Margin="0,0,0,18"/>

                            <!-- Active Provider Selection -->
                            <Border Grid.Row="2" Background="#121216" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="4" Padding="12,10" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE_MODULE:" Foreground="#888890" FontSize="11" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="RadioGemini" Content="Gemini Flash" IsChecked="True" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioGeminiPro" Content="Gemini Pro" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioOpenAI" Content="OpenAI (GPT-4o)" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioAnthropic" Content="Anthropic (Claude)" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Gemini -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="GEMINI_API_KEY" Foreground="#BBBBBF" FontSize="12" Width="150"/>
                                <TextBlock FontSize="11"><Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#888890">[ GET_KEY ]</Hyperlink></TextBlock>
                            </StackPanel>
                            <PasswordBox Grid.Row="4" x:Name="TxtGemini" Margin="0,0,0,14" Background="#141418" Foreground="#E8E8EC" BorderBrush="#28282E" BorderThickness="1.5" Padding="8,6" FontFamily="Consolas"/>

                            <!-- OpenAI -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="OPENAI_API_KEY" Foreground="#BBBBBF" FontSize="12" Width="150"/>
                                <TextBlock FontSize="11"><Hyperlink NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#888890">[ GET_KEY ]</Hyperlink></TextBlock>
                            </StackPanel>
                            <PasswordBox Grid.Row="6" x:Name="TxtOpenAI" Margin="0,0,0,14" Background="#141418" Foreground="#E8E8EC" BorderBrush="#28282E" BorderThickness="1.5" Padding="8,6" FontFamily="Consolas"/>

                            <!-- Anthropic -->
                            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="ANTHROPIC_KEY" Foreground="#BBBBBF" FontSize="12" Width="150"/>
                                <TextBlock FontSize="11"><Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#888890">[ GET_KEY ]</Hyperlink></TextBlock>
                            </StackPanel>
                            <PasswordBox Grid.Row="8" x:Name="TxtAnthropic" Margin="0,0,0,18" Background="#141418" Foreground="#E8E8EC" BorderBrush="#28282E" BorderThickness="1.5" Padding="8,6" FontFamily="Consolas"/>

                            <Border Grid.Row="12" Background="#121216" BorderBrush="#24242A" BorderThickness="1.5" CornerRadius="4" Padding="12,10" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkShowBuddy" Content="Show Floating Buddy" ToolTip="Display the floating SumoSnap buddy in the bottom right corner" IsChecked="True" Margin="0,0,28,0"/>
                                    <CheckBox x:Name="ChkRunOnStartup" Content="Run on Startup" ToolTip="Launch SumoSnap silently in the system tray when Windows starts" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="13" Content="SAVE CONFIG" HorizontalAlignment="Right" Click="SaveButton_Click" Margin="0,4,0,0" Style="{StaticResource SaveButtonStyle}"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
