<Window x:Class="SumoSnap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SumoSnap Settings" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Topmost="True">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="To keep this app lightning fast and free of subscriptions, it connects directly to AI providers. Your keys are saved locally on this computer." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Remove.bg API Key" FontWeight="Bold" Width="130"/>
            <TextBlock><Hyperlink NavigateUri="https://www.remove.bg/api" RequestNavigate="Hyperlink_RequestNavigate">👉 Get free key here</Hyperlink></TextBlock>
        </StackPanel>
        <TextBox Grid.Row="2" x:Name="TxtRemoveBg" Margin="0,0,0,15" Padding="5"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Stability AI API Key" FontWeight="Bold" Width="130"/>
            <TextBlock><Hyperlink NavigateUri="https://platform.stability.ai/account/keys" RequestNavigate="Hyperlink_RequestNavigate">👉 Get free key here</Hyperlink></TextBlock>
        </StackPanel>
        <TextBox Grid.Row="4" x:Name="TxtStability" Margin="0,0,0,15" Padding="5"/>

        <Button Grid.Row="7" Content="Save Settings" Width="120" HorizontalAlignment="Right" Padding="5" Click="SaveButton_Click"/>
    </Grid>
</Window>
