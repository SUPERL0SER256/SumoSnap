<Window x:Class="SumoSnap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SumoSnap Settings" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222222"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI Chat Providers" FontSize="16" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Select your preferred AI and enter its API key. Your keys are saved locally on this computer." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,20"/>

        <!-- Active Provider Selection -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Active AI:" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="RadioGemini" Content="Gemini 3.6 Flash" IsChecked="True" VerticalAlignment="Center"/>
            <RadioButton x:Name="RadioOpenAI" Content="OpenAI (GPT-4o)" VerticalAlignment="Center"/>
            <RadioButton x:Name="RadioAnthropic" Content="Anthropic (Claude 3.5)" VerticalAlignment="Center"/>
        </WrapPanel>

        <!-- Gemini -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Google Gemini Key" FontWeight="Bold" Width="140"/>
            <TextBlock><Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#8AB4F8">Get free key here</Hyperlink></TextBlock>
        </StackPanel>
        <TextBox Grid.Row="4" x:Name="TxtGemini" Margin="0,0,0,15"/>

        <!-- OpenAI -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="OpenAI Key" FontWeight="Bold" Width="140"/>
            <TextBlock><Hyperlink NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#8AB4F8">Get key here</Hyperlink></TextBlock>
        </StackPanel>
        <TextBox Grid.Row="6" x:Name="TxtOpenAI" Margin="0,0,0,15"/>

        <!-- Anthropic -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Anthropic Key" FontWeight="Bold" Width="140"/>
            <TextBlock><Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#8AB4F8">Get key here</Hyperlink></TextBlock>
        </StackPanel>
        <TextBox Grid.Row="8" x:Name="TxtAnthropic" Margin="0,0,0,15"/>

        <Button Grid.Row="9" Content="Save Settings" HorizontalAlignment="Right" Click="SaveButton_Click"/>
    </Grid>
</Window>
