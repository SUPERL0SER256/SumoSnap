<Window x:Class="SumoSnap.PostCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SumoSnap Editor" Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E">
    <Window.Resources>
        <!-- Transparent Icon Buttons for Top Right -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Send Button Style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111"/> <!-- Black background -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Scrollable Image & Chat -->
            <RowDefinition Height="Auto"/> <!-- Input Bar -->
        </Grid.RowDefinitions>

        <!-- Top Right Actions -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="📋" ToolTip="Copy to Clipboard" Style="{StaticResource IconButtonStyle}" Click="CopyButton_Click"/>
            <Button Content="💾" ToolTip="Save to Disk" Style="{StaticResource IconButtonStyle}" Click="SaveButton_Click" Margin="5,0"/>
            <Button Content="⚙" ToolTip="Settings" Style="{StaticResource IconButtonStyle}" Click="SettingsButton_Click"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,20">
                <!-- Image Preview -->
                <Border BorderBrush="#333" BorderThickness="1" CornerRadius="8" Background="#111" Margin="0,0,0,20">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10" MaxHeight="400" HorizontalAlignment="Center"/>
                </Border>
                
                <!-- Chat Messages Flow Below Image -->
                <StackPanel x:Name="ChatMessages"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Persistent Input Bar at Bottom -->
        <Border Grid.Row="2" Background="#2A2A2A" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="ChatInput" Grid.Column="0" 
                         Background="#333" Foreground="White" CaretBrush="White" 
                         BorderThickness="0" Padding="10,6" FontSize="14" 
                         AcceptsReturn="False" KeyDown="ChatInput_KeyDown" 
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Loading Spinner / Indicator -->
                <TextBlock x:Name="LoadingIndicator" Grid.Column="1" Text="Thinking..." Foreground="Gray" VerticalAlignment="Center" Margin="15,0" Visibility="Collapsed" FontStyle="Italic"/>

                <Button x:Name="SendButton" Grid.Column="1" Content="Ask" Style="{StaticResource SendButtonStyle}" Margin="15,0,0,0" Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
